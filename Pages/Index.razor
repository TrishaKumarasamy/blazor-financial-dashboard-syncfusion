@page "/"

<PageTitle>Financial Analytics Dashboard</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="text-center py-5">
                <i class="fas fa-chart-line text-primary" style="font-size: 4rem;"></i>
                <h1 class="display-4 mt-3 text-primary">Financial Analytics Dashboard</h1>
                <p class="lead text-muted">Powerful financial data analysis with Syncfusion Blazor Pivot Table</p>
                <a href="/financial-dashboard" class="btn btn-primary btn-lg mt-3">
                    <i class="fas fa-chart-pie me-2"></i>
                    Open Dashboard
                </a>
            </div>
        </div>
    </div>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-table-cells text-success fs-1 mb-3"></i>
                    <h5 class="card-title">Pivot Analysis</h5>
                    <p class="card-text">Interactive pivot table with drag-and-drop field arrangement for dynamic data analysis.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-chart-column text-info fs-1 mb-3"></i>
                    <h5 class="card-title">Visual Insights</h5>
                    <p class="card-text">Rich charts and graphs showing financial trends across regions and departments.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-list-ul text-warning fs-1 mb-3"></i>
                    <h5 class="card-title">Detailed Records</h5>
                    <p class="card-text">Comprehensive transaction listing with filtering, sorting, and export capabilities.</p>
                </div>
            </div>
        </div>
    </div>
</div>
